{
  "extends": ["stylelint-config-standard"],
  "overrides": [
    {
      "files": ["blocks/header/*.css", "blocks/footer/*.css", "styles/styles.css"],
      "rules": {
        "selector-class-pattern": [
          "^[a-z][a-zA-Z0-9]*(?:(?:-{1,2}|_{2})[a-zA-Z0-9]+)*$",
          { "message": "Expected kebab-case or the source's BEM class names (block__element--modifier)" }
        ]
      }
    },
    {
      "files": ["blocks/header/*.css", "blocks/footer/*.css"],
      "rules": {
        "no-descending-specificity": null
      }
    }
  ]
}
