   "items": [
    {
     "role": "body",
     "order": 0,
     "text": "Darf ich an Halloween Waffen tragen?"
    },
    {
     "role": "body",
     "order": 1,
     "text": "Zu manch gruseligen Halloween-Kostümen gehören Spielzeugpistolen oder -dolche einfach dazu. Zu echt dürfen diese aber nicht aussehen."
    },
    {
     "role": "cta",
     "order": 2,
     "text": "Mehr lesen",
     "href": "/de/rechtsportal/rechtsfrage-des-tages/halloween-mit-gummidolch"
    },
    {
     "role": "body",
     "order": 3,
     "text": "Für Gewerbekunden"
    },
    {
     "role": "body",
     "order": 4,
     "text": "Kann ich Überstunden anordnen?"
    },
    {
     "role": "body",
     "order": 5,
     "text": "Manchmal ist mehr zu tun, als die reguläre Arbeitszeit hergibt. Als Arbeitgeber müssen Sie wissen, welche Regeln zu Überstunden gelten."
    },
    {
     "role": "cta",
     "order": 6,
     "text": "Mehr lesen",
     "href": "/de/rechtsportal/gewerbe/kann-ich-ueberstunden-anordnen"
