    },
    {
     "role": "body",
     "order": 1,
     "text": "Schützen Sie Ihr Unternehmen gegen Cyber-Risiken"
    },
    {
     "role": "cta",
     "order": 2,
     "text": "Angebot anfordern",
     "href": "https://www.ergo.de/de/Resources/Forms/Kontakt/Kontakt?popref=https://www.ergo.de/de/Geschaeftskunden-Produkte/Cyber-Versicherung-fuer-Unternehmen"
