   "h1": "Dienstreiseversicherung",
   "title": "Sichern Sie Ihre Mitarbeiter auf Dienstreisen umfangreich ab",
   "textHtml": null,
   "ctas": [
    {
     "tag": "a",
     "label": "Angebot anfordern",
     "href": "https://www.ergo.de/de/Resources/Forms/Kontakt/Kontakt?popref=https%3A%2F%2Fwww.ergo.de%2Fde%2FGeschaeftskunden-Produkte%2FDienstreiseversicherung",
     "aria": "Angebot anfordern",
